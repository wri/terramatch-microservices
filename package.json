  "scripts": {
    "user": "nx serve user-service --no-cloud",
    "entity": "nx serve entity-service --no-cloud",
    "research": "nx serve research-service --no-cloud",
    "unified-database": "nx serve unified-database-service --no-cloud",
    "fe-services": "nx run-many -t serve --parallel=10 --no-cloud --no-tui --projects user-service job-service entity-service research-service dashboard-service",
    "all": "nx run-many --parallel=100 -t serve --no-cloud",
    "prepare": "husky",
    "test:ci": "nx run-many -t test --parallel=1 --no-cloud --coverage --runInBand --passWithNoTests",
    "lint-build": "nx run-many -t lint build --exclude tm-v3-cli --no-cloud --verbose",
    "schema:audit": "ts-node --transpile-only -P tsconfig.schema-audit.json libs/database/src/lib/tools/schema-audit-sequelize-vs-db.ts"
  },
  "private": true,
